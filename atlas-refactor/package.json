{
  "name": "petroleum-atlas",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vite build && node scripts/verify-build.mjs",
    "check:dist": "node scripts/verify-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/browser.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "d3-hierarchy": "^3.1.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.2.0",
    "idb": "^8.0.0",
    "svelte": "^5.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
