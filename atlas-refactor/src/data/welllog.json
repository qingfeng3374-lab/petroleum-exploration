.9,250.3 177.9,251.2 182.5,252.0 185.5,252.9 186.2,253.8 179.6,254.7 186.2,255.6 184.5,256.5 180.0,257.3 176.2,258.2 177.7,259.1 176.8,260.0\" fill=\"none\" stroke=\"#31393d\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/><line x1=\"330\" y1=\"30\" x2=\"330\" y2=\"260\" stroke=\"#c9c2b0\" stroke-width=\"1\"/><line x1=\"106\" y1=\"99\" x2=\"346\" y2=\"99\" stroke=\"#b26a39\" stroke-width=\"1.6\"/><circle cx=\"106\" cy=\"99\" r=\"2.6\" fill=\"#b26a39\"/><line x1=\"106\" y1=\"142.7\" x2=\"346\" y2=\"142.7\" stroke=\"#b26a39\" stroke-width=\"1.6\"/><circle cx=\"106\" cy=\"142.7\" r=\"2.6\" fill=\"#b26a39\"/><line x1=\"106\" y1=\"172.6\" x2=\"346\" y2=\"172.6\" stroke=\"#b26a39\" stroke-width=\"1.6\"/><circle cx=\"106\" cy=\"172.6\" r=\"2.6\" fill=\"#b26a39\"/><line x1=\"106\" y1=\"237\" x2=\"346\" y2=\"237\" stroke=\"#b26a39\" stroke-width=\"1.6\"/><circle cx=\"106\" cy=\"237\" r=\"2.6\" fill=\"#b26a39\"/><rect x=\"118\" y=\"191\" width=\"214\" height=\"10.349999999999994\" fill=\"#f2d98a\" opacity=\".5\" rx=\"2\"/><line x1=\"362\" y1=\"196.175\" x2=\"390\" y2=\"196.175\" stroke=\"#b26a39\" stroke-width=\"1\"/><text x=\"394\" y=\"199.675\" font-size=\"10\" fill=\"#b26a39\">0.8 m 薄层 · 漏卡</text><text x=\"358\" y=\"82.80000000000001\" font-size=\"9.5\" fill=\"#2f7d6b\">真实界面</text><text x=\"104\" y=\"92\" font-size=\"9.5\" fill=\"#b26a39\" text-anchor=\"end\">人工卡层</text><line x1=\"308\" y1=\"89.80000000000001\" x2=\"308\" y2=\"99\" stroke=\"#b26a39\" stroke-width=\"1\"/><line x1=\"304\" y1=\"89.80000000000001\" x2=\"312\" y2=\"89.80000000000001\" stroke=\"#b26a39\" stroke-width=\"1\"/><line x1=\"304\" y1=\"99\" x2=\"312\" y2=\"99\" stroke=\"#b26a39\" stroke-width=\"1\"/><text x=\"390\" y=\"97.4\" font-size=\"9.5\" fill=\"#b26a39\">偏移 1.2 m</text><text x=\"118\" y=\"16\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#9ba3a9\" letter-spacing=\"1\">GR (API)</text><text x=\"330\" y=\"278\" text-anchor=\"end\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#9ba3a9\">深度 / m</text></svg></div><div class=\"figcap\"><b>图 1</b><span>同一段曲线的三种典型误差：界面系统性偏移（左上）、薄层漏卡（右下）、以及不同解释员之间不重合的判定区间。这些是&quot;人工目视 + 经验&quot;的固有代价，也是算法要替代的部分。</span></div>"},{"no":2,"en":"INTERVENTION","title":"AI 能做什么","html":"<p>把分层建模成<b>曲线序列上的变点检测</b>：先算滑窗统计特征（均值差、方差比、斜率），再用最优分段或 1D 分割网络给出候选界面，最后用地质规则过滤。</p><p>注意这里替换的是<b>工序中的一步</b>，不是整个岗位。算法负责把上千米曲线压缩成几十个候选界面，解释员仍然负责地质合理性判断 —— 既有提速，也保留了责任边界。</p><div class=\"figure\"><svg viewBox=\"0 0 620 132\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"AI 介入点流程\"><rect x=\"8\" y=\"26\" width=\"108\" height=\"72\" rx=\"8\" fill=\"#e6f1ec\" stroke=\"#2f7d6b\" stroke-opacity=\".28\"/><rect x=\"8\" y=\"26\" width=\"3\" height=\"72\" rx=\"1.5\" fill=\"#2f7d6b\"/><text x=\"21\" y=\"49\" font-size=\"11.5\" font-weight=\"600\" fill=\"#242b2e\">原始曲线</text><text x=\"21\" y=\"69\" font-size=\"9\" fill=\"#5d666d\">多井 GR / SP / RT</text><text x=\"105\" y=\"92\" text-anchor=\"end\" font-size=\"8.5\" font-family=\"monospace\" fill=\"#2f7d6b\">01</text><path d=\"M119 62h9m-3.5-3.4 3.6 3.4-3.6 3.4\" stroke=\"#c9c2b0\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"133\" y=\"26\" width=\"108\" height=\"72\" rx=\"8\" fill=\"#e7eef9\" stroke=\"#41699b\" stroke-opacity=\".28\"/><rect x=\"133\" y=\"26\" width=\"3\" height=\"72\" rx=\"1.5\" fill=\"#41699b\"/><text x=\"146\" y=\"49\" font-size=\"11.5\" font-weight=\"600\" fill=\"#242b2e\">滑窗特征</text><text x=\"146\" y=\"69\" font-size=\"9\" fill=\"#5d666d\">均值差</text><text x=\"146\" y=\"83\" font-size=\"9\" fill=\"#5d666d\">方差比</text><text x=\"146\" y=\"97\" font-size=\"9\" fill=\"#5d666d\">斜率</text><text x=\"230\" y=\"92\" text-anchor=\"end\" font-size=\"8.5\" font-family=\"monospace\" fill=\"#41699b\">02</text><path d=\"M244 62h9m-3.5-3.4 3.6 3.4-3.6 3.4\" stroke=\"#c9c2b0\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"258\" y=\"26\" width=\"108\" height=\"72\" rx=\"8\" fill=\"#efe9f4\" stroke=\"#7e5a8d\" stroke-opacity=\".28\"/><rect x=\"258\" y=\"26\" width=\"3\" height=\"72\" rx=\"1.5\" fill=\"#7e5a8d\"/><text x=\"271\" y=\"49\" font-size=\"11.5\" font-weight=\"600\" fill=\"#242b2e\">最优分段</text><text x=\"271\" y=\"69\" font-size=\"9\" fill=\"#5d666d\">动态规划 + 惩罚项</text><text x=\"355\" y=\"92\" text-anchor=\"end\" font-size=\"8.5\" font-family=\"monospace\" fill=\"#7e5a8d\">03</text><path d=\"M369 62h9m-3.5-3.4 3.6 3.4-3.6 3.4\" stroke=\"#c9c2b0\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"383\" y=\"26\" width=\"108\" height=\"72\" rx=\"8\" fill=\"#f8ecdf\" stroke=\"#b26a39\" stroke-opacity=\".28\"/><rect x=\"383\" y=\"26\" width=\"3\" height=\"72\" rx=\"1.5\" fill=\"#b26a39\"/><text x=\"396\" y=\"49\" font-size=\"11.5\" font-weight=\"600\" fill=\"#242b2e\">规则后处理</text><text x=\"396\" y=\"69\" font-size=\"9\" fill=\"#5d666d\">最小层厚</text><text x=\"396\" y=\"83\" font-size=\"9\" fill=\"#5d666d\">层序一致</text><text x=\"480\" y=\"92\" text-anchor=\"end\" font-size=\"8.5\" font-family=\"monospace\" fill=\"#b26a39\">04</text><path d=\"M494 62h9m-3.5-3.4 3.6 3.4-3.6 3.4\" stroke=\"#c9c2b0\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/><rect x=\"508\" y=\"26\" width=\"108\" height=\"72\" rx=\"8\" fill=\"#f1f1dd\" stroke=\"#767a2e\" stroke-opacity=\".28\"/><rect x=\"508\" y=\"26\" width=\"3\" height=\"72\" rx=\"1.5\" fill=\"#767a2e\"/><text x=\"521\" y=\"49\" font-size=\"11.5\" font-weight=\"600\" fill=\"#242b2e\">候选界面</text><text x=\"521\" y=\"69\" font-size=\"9\" fill=\"#5d666d\">人工只做确认</text><text x=\"605\" y=\"92\" text-anchor=\"end\" font-size=\"8.5\" font-family=\"monospace\" fill=\"#767a2e\">05</text><text x=\"8\" y=\"16\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#9ba3a9\" letter-spacing=\"1\">ALGORITHM</text><text x=\"167\" y=\"16\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#b26a39\" letter-spacing=\"1\">HUMAN CORE</text><line x1=\"8\" y1=\"112\" x2=\"258\" y2=\"112\" stroke=\"#2f7d6b\" stroke-width=\"1.4\"/><text x=\"204\" y=\"126\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"#2f7d6b\">算法负责把上千米曲线压缩成几十个候选</text><line x1=\"167\" y1=\"112\" x2=\"616\" y2=\"112\" stroke=\"#b26a39\" stroke-width=\"1.4\"/><text x=\"499.5\" y=\"126\" text-anchor=\"middle\" font-size=\"9.5\" fill=\"#b26a39\">人负责地质合理性</text></svg></div><div class=\"figcap\"><b>图 2</b><span>从原始曲线到分层表的五步。真正决定效果的不是网络有多深，而是第 4 步的规则：<b>最小层厚</b>与<b>邻井层序一致性</b>能把大量&quot;数学上成立、地质上荒谬&quot;的界面直接过滤掉。</span></div>"},{"no":3,"en":"DATA","title":"你需要准备什么","html":"<p style=\"margin-bottom:14px\">立项前先对着这张清单打勾。<b>勾不满不代表不能做</b>，但每一项空缺都会在后期变成返工。清单可点击，勾选状态只在本页有效。</p><div class=\"checklist\"><div class=\"cl-head\"><span>数据准备清单 · 5 项</span><span class=\"cl-prog\"><span id=\"cl-txt\">0 / 5</span><span class=\"cl-bar\"><i id=\"cl-fill\"></i></span></span></div><div class=\"cl-item\" data-cl=\"0\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">常规测井曲线</span><span class=\"cl-s\">GR / SP / RT / DEN，0.125 m 采样，单井 5000—20000 点</span></span><span class=\"cl-n\">30—50 口井的人工分层表</span></div><div class=\"cl-item\" data-cl=\"1\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">邻井分层与岩性</span><span class=\"cl-s\">同区块 20 口以上</span></span><span class=\"cl-n\">作为一致性约束</span></div><div class=\"cl-item\" data-cl=\"2\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">地质分层方案</span><span class=\"cl-s\">油田统一的分层标准</span></span><span class=\"cl-n\">定义层序与命名</span></div><div class=\"cl-item\" data-cl=\"3\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">井位与构造图</span><span class=\"cl-s\">区块级</span></span><span class=\"cl-n\">判断层序是否可信</span></div><div class=\"cl-item\" data-cl=\"4\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">历史解释成果</span><span class=\"cl-s\">已有解释报告</span></span><span class=\"cl-n\">用于交叉验证</span></div></div><p style=\"margin-top:18px\"><span class=\"kicker plain\" style=\"color:var(--ink-4)\">可参考的公开数据集</span></p><div class=\"refs\"><a class=\"ref\" href=\"#/method/cv\">FORCE 2020 岩性竞赛数据（井曲线 + 岩性标签）<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"#/method/cv\">Kansas Geological Survey 公开测井库<span class=\"ar\">↗</span></a></div>"},{"no":4,"en":"DIFFICULTY","title":"技术难度与参考方向","html":"<div style=\"display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:2px\"><span class=\"dtag\" data-d=\"中\">难度 中</span><span class=\"small muted\">单井数据易得、任务定义清晰；难点在标签粒度不一致与薄层漏检。</span></div><div class=\"meter\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"\"></i></div><p>难度按三档标注：<b>低</b> = 数据现成、任务边界清晰、错了代价小；<b>中</b> = 需要一个月量级的标注与清洗，效果依赖后处理规则；<b>高</b> = 标签稀缺或安全约束硬，通常要先做小范围可行性验证再立项。</p><p style=\"margin-top:18px\"><span class=\"kicker plain\" style=\"color:var(--ink-4)\">可借鉴的通用技术</span></p><div class=\"refs\"><a class=\"ref\" href=\"#/method/ts\">变点检测<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"#/method/ts\">序列分割<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"#/method/ts\">1D 卷积网络<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"#/method/ts\">地质规则后处理<span class=\"ar\">↗</span></a></div><p style=\"margin-top:18px\" class=\"small muted\">交叉环节：<a href=\"#/stage/mudlog\" style=\"color:var(--jade-d);font-weight:600\">录井</a> · <a href=\"#/stage/geophys\" style=\"color:var(--jade-d);font-weight:600\">物探</a></p>"}]},"workflow":{"label":"案例流程","title":"案例：A 区块 42 口井的自动卡层","lead":["A 区块有 42 口开发井，常规曲线齐全，解释组按油田统一分层方案手工卡出 8 个标志层界面。目标不是\"做出一个模型\"，而是**把单井卡层工时从 3.5 小时压到 15 分钟（仅复核）**，同时把界面偏差控制在 0.5 m 以内。","下面五步是这个案例的真实流程。注意第 2 步和第 4 步：它们不涉及任何模型，却决定了最终能不能用。"],"stats":[["样本井","42",true],["单井采样点","8000",true],["标志层","8",true],["界面目标偏差","≤0.5 m"],["人工工时","3.5 h / 井"],["辅助后工时","15 min / 井"]],"steps":[{"name":"数据准备与对齐","role":"工程环节","do":"把 42 口井的曲线统一到 0.125 m 采样，深度归位，并按**井**划分训练 / 验证集（不能按样本随机划分，否则同井信息泄漏）。","effect":"同一口井的曲线只出现在一个集合里","trap":"样本量看着很大，实际独立样本只有几十口井"},{"name":"标签规范化","role":"工程环节","do":"把不同解释员的层号映射到同一套地层方案，界面深度取中位数，层数不一致的井标注置信度。","effect":"标签从\"每人一套\"变成\"一套 + 置信度\"","trap":"层数定义不统一会让模型学成\"平均解释员\""},{"name":"候选界面生成","role":"算法核心","do":"滑窗统计特征（均值差、方差比、斜率）+ 变点检测，或用 1D U-Net 做序列分割，输出界面概率。","effect":"召回优先：宁可多给候选，也不漏真界面","trap":"直接追求高精度会把薄层全部滤掉"},{"name":"规则后处理","role":"效果关键","do":"最小层厚 1 m、层序与邻井一致、界面不得穿过明显曲线趋势，逐条过滤不合理候选。","effect":"把\"数学界面\"变成\"地质界面\"","trap":"规则过严会连带删掉真实的薄互层"},{"name":"人工确认与回流","role":"闭环","do":"解释员在候选界面上做增删改，修正结果自动回到训练集，形成闭环。","effect":"每口新井都在提升下一口井的效果","trap":"没有回流机制，模型三个月后就过期"}],"metrics":{"title":"怎么算\"分对了\"","html":"<p>分层不是逐点分类，而是<b>界面匹配</b>问题：一个界面只要落在真实界面 ±1 m 容差内就算命中。这决定了指标的计算方式，也解释了为什么\"准确率 99%\"在这里毫无意义 —— 界面点只占全井段的千分之一，全判成\"不是界面\"也有 99.9%。</p><div class=\"figure\"><svg viewBox=\"0 0 620 186\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"容差匹配示意\"><rect x=\"8\" y=\"10\" width=\"192\" height=\"150\" rx=\"9\" fill=\"#fdfcf9\" stroke=\"#e9e4d8\"/><text x=\"20\" y=\"26\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#2f7d6b\" letter-spacing=\".8\">TP · 命中</text><line x1=\"34\" y1=\"34\" x2=\"34\" y2=\"142\" stroke=\"#ddd7c8\"/><line x1=\"174\" y1=\"34\" x2=\"174\" y2=\"142\" stroke=\"#ddd7c8\"/><rect x=\"34\" y=\"87.8\" width=\"140\" height=\"22\" fill=\"#e6f1ec\"/><line x1=\"34\" y1=\"98.8\" x2=\"174\" y2=\"98.8\" stroke=\"#2f7d6b\" stroke-width=\"1.2\" stroke-dasharray=\"4 3\"/><text x=\"178\" y=\"102.3\" font-size=\"8\" font-family=\"monospace\" fill=\"#2f7d6b\">真</text><line x1=\"34\" y1=\"100.96\" x2=\"174\" y2=\"100.96\" stroke=\"#2f7d6b\" stroke-width=\"2\"/><circle cx=\"34\" cy=\"100.96\" r=\"3\" fill=\"#2f7d6b\"/><text x=\"178\" y=\"104.46\" font-size=\"8\" font-family=\"monospace\" fill=\"#2f7d6b\">测</text><line x1=\"48\" y1=\"98.8\" x2=\"48\" y2=\"100.96\" stroke=\"#c9c2b0\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/><text x=\"20\" y=\"168\" font-size=\"9.5\" fill=\"#79828a\">落在 ±1 m 内</text><rect x=\"214\" y=\"10\" width=\"192\" height=\"150\" rx=\"9\" fill=\"#fdfcf9\" stroke=\"#e9e4d8\"/><text x=\"226\" y=\"26\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#b26a39\" letter-spacing=\".8\">FP · 多检</text><line x1=\"240\" y1=\"34\" x2=\"240\" y2=\"142\" stroke=\"#ddd7c8\"/><line x1=\"380\" y1=\"34\" x2=\"380\" y2=\"142\" stroke=\"#ddd7c8\"/><rect x=\"240\" y=\"96.44000000000001\" width=\"140\" height=\"22\" fill=\"#f8ecdf\"/><line x1=\"240\" y1=\"107.44000000000001\" x2=\"380\" y2=\"107.44000000000001\" stroke=\"#2f7d6b\" stroke-width=\"1.2\" stroke-dasharray=\"4 3\"/><text x=\"384\" y=\"110.94000000000001\" font-size=\"8\" font-family=\"monospace\" fill=\"#2f7d6b\">真</text><line x1=\"240\" y1=\"66.4\" x2=\"380\" y2=\"66.4\" stroke=\"#b26a39\" stroke-width=\"2\"/><circle cx=\"240\" cy=\"66.4\" r=\"3\" fill=\"#b26a39\"/><text x=\"384\" y=\"69.9\" font-size=\"8\" font-family=\"monospace\" fill=\"#b26a39\">测</text><line x1=\"254\" y1=\"107.44000000000001\" x2=\"254\" y2=\"66.4\" stroke=\"#c9c2b0\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/><text x=\"226\" y=\"168\" font-size=\"9.5\" fill=\"#79828a\">容差内没有真界面</text><rect x=\"420\" y=\"10\" width=\"192\" height=\"150\" rx=\"9\" fill=\"#fdfcf9\" stroke=\"#e9e4d8\"/><text x=\"432\" y=\"26\" font-size=\"9.5\" font-family=\"monospace\" fill=\"#b05a51\" letter-spacing=\".8\">FN · 漏检</text><line x1=\"446\" y1=\"34\" x2=\"446\" y2=\"142\" stroke=\"#ddd7c8\"/><line x1=\"586\" y1=\"34\" x2=\"586\" y2=\"142\" stroke=\"#ddd7c8\"/><rect x=\"446\" y=\"70.52000000000001\" width=\"140\" height=\"22\" fill=\"#f9e9e5\"/><line x1=\"446\" y1=\"81.52000000000001\" x2=\"586\" y2=\"81.52000000000001\" stroke=\"#2f7d6b\" stroke-width=\"1.2\" stroke-dasharray=\"4 3\"/><text x=\"590\" y=\"85.02000000000001\" font-size=\"8\" font-family=\"monospace\" fill=\"#2f7d6b\">真</text><text x=\"432\" y=\"168\" font-size=\"9.5\" fill=\"#79828a\">真界面没被检出</text></svg></div><div class=\"figcap\"><b>图 3</b><span>按容差匹配后统计 TP / FP / FN，再算精确率与召回率。<b>漏检（FN）比误检（FP）代价更高</b>：漏掉一个界面意味着人工要重新扫一遍整段曲线，而多一个候选界面只需点一下删除。</span></div><table class=\"dtable\"><thead><tr><th>指标</th><th>定义</th><th>本例取值</th></tr></thead><tbody><tr><td>精确率 P</td><td>TP / (TP + FP)，给出的候选里有多少是对的</td><td>0.82</td></tr><tr><td>召回率 R</td><td>TP / (TP + FN)，真实界面里找回了多少</td><td>0.91</td></tr><tr><td>F1</td><td>2PR / (P + R)</td><td>0.86</td></tr><tr><td>平均偏差</td><td>命中界面的绝对深度误差均值（m）</td><td>0.34 m</td></tr></tbody></table>"},"fails":[{"name":"薄层漏检","why":"厚度小于最小层厚（本例 1 m）的层在惩罚项下会被合并。解决方向是分层建模：先粗分大层，再在小层内单独检测薄层。"},{"name":"渐变过渡带","why":"岩性渐变时曲线没有突变点，算法倾向把过渡带整体归入一侧。可用斜率特征或软分割概率代替硬界面。"},{"name":"曲线缺失段","why":"某条曲线在井段内缺失时，多通道模型会被\"补零\"误导。应先做缺失标记，让模型显式知道哪一通道不可用。"},{"name":"层序冲突","why":"算法可能给出与区域地层方案矛盾的层序（如标志层倒置）。必须加层序约束或人工审核规则。"}]},"demo":{"builtin":"welllog-layer"}}}